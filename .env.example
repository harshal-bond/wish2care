# Wish2Care SAFE Wellness Score Tool — Environment Variables

# Database
# Local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wish2care
# Neon on Railway: use the POOLED URL (host contains -pooler), e.g.
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Do NOT raise max connections on the app to fix "server unreachable" — use the pooler URL
# and keep DB_POOL_MAX low (default 5 with pooler, 10 without). More app connections can
# make DB exhaustion worse and crash the Railway service for all devices.
# DB_POOL_MAX=5
#
# Keepalive (cuts free-tier wake spikes): ping every 4–5 min
#   GET https://YOUR-RAILWAY-URL/api/health      (process)
#   GET https://YOUR-RAILWAY-URL/api/health/db   (Neon SELECT 1)

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Frontend (local dev). On Vercel set this to your public Railway URL, e.g.
# https://your-service.up.railway.app/api — never leave localhost in production.
VITE_API_URL=http://localhost:3000/api

# Backend CORS — optional extra origins (comma-separated). Defaults always include
# https://app.wish2care.in, wish2care-frontend.vercel.app, all *.vercel.app previews, and localhost.
# Do NOT set this to your Railway URL — CORS origins are FRONTEND URLs only.
# CORS_ORIGINS=https://wish2care.example.com
# Or set a single canonical frontend:
# FRONTEND_URL=https://wish2care-frontend.vercel.app

# Admin seed credentials
ADMIN_EMAIL=admin@wish2care.org
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User
